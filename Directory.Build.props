<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- One version for the package (see CHANGELOG.md); a VersionSuffix makes a prerelease. -->
    <VersionPrefix>0.2.0</VersionPrefix>

    <Authors>AbpCluster contributors</Authors>
    <Company>Tekthar</Company>
    <Copyright>Copyright 2026 AbpCluster contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tekthar/abp-cluster</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tekthar/abp-cluster.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>abp;cluster;lock;advisory-lock;distributed-lock;postgresql;high-availability</PackageTags>
    <PackageReleaseNotes>https://github.com/tekthar/abp-cluster/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AbpVersion>10.6.1</AbpVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
